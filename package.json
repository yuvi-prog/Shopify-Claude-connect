{
  "name": "shopify-mcp-server",
  "version": "1.0.0",
  "description": "Remote MCP server exposing Shopify Admin API data to Claude",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
